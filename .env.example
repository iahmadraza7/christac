# The Courtship Decoder — backend configuration.
# Copy to .env and fill in. Nothing below is hardcoded in the code.

# --- provider and model ----------------------------------------------------
# PROVIDER: anthropic | openai | google
PROVIDER=anthropic
# No default on purpose. The service refuses to start without it.
MODEL=

# Only the key for the provider above is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- who may embed and call it ---------------------------------------------
# Comma separated, scheme included, no trailing slash. Her Kajabi domain.
# Used for both the Origin allowlist and the iframe frame-ancestors rule.
# Leave empty and the page can be embedded nowhere.
ALLOWED_ORIGINS=https://her-site.kajabi.com

# Set true only behind a proxy or CDN you control, so X-Forwarded-For can be
# trusted for rate limiting. Leaving it false uses the socket address.
TRUST_PROXY=false

# A POST to /api/chat must say where it came from: an Origin on the list above,
# or Sec-Fetch-Site: same-origin, which browsers send even where they leave
# Origin off a same-origin POST. Without this a plain script reaches the model
# and spends her credit without ever touching Kajabi.
#
# Serving the page is unaffected, so the page always loads.
#
# Set false ONLY if a real visitor's browser turns out to send neither header.
# That reopens the hole, so put it back once the browser is identified. Every
# accepted POST logs how it identified itself, as "via=origin" or
# "via=sec-fetch-site", so the log answers the question.
REQUIRE_ORIGIN=true

# --- limits ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=12
# The hard ceiling PER MAN, not per session - the name is kept only so an
# existing deployment does not need editing. Input + output, counted from what
# the provider reports, and reset when she moves to another man.
#
# 1,500,000 is 1.27x the worst a man can cost inside the 20-turn limit. Once a
# verdict lands every turn carries the lesson file, 56,843 tokens at Stage 1,
# so 19 such turns reach 1,179,214. The turn limit fires first; this is only a
# backstop. The old 250,000 was reached after 4.4 post-verdict turns.
MAX_TOKENS_PER_CONVERSATION=1500000
MAX_OUTPUT_TOKENS=2048
MAX_MESSAGE_CHARS=4000
CONVERSATION_TTL_MINUTES=120

# --- verdict detection -----------------------------------------------------
# How much of a DELIVER AS WRITTEN block a reply must reproduce before the
# lesson file is appended. Measured on 26 real turns: delivered blocks scored
# 0.90-1.00, everything else 0.06 or below.
VERDICT_MATCH_THRESHOLD=0.35

# --- cost and overuse controls ---------------------------------------------
# One conversation cannot sprawl. Her method ends after the verdict and the
# next step, so this sits well above a real conversation but still stops one
# that runs away.
MAX_TURNS_PER_CONVERSATION=20

# Going back over a man already decoded cannot reach a different answer, so
# the service answers those without calling the model at all.
# WINDOW: how many of her turns after a verdict this stays armed.
# SIMILARITY: how much of her wording must already have been said (0-1) for a
# message to count as a restatement rather than new behaviour. Pushback and a
# new man both score low, so neither is caught.
REPEAT_DECODE_WINDOW_TURNS=3
REPEAT_DECODE_SIMILARITY=0.60
# Approved by her as drafted.
# One line only. A setting cannot span lines - write the break as \n and the
# service turns it into a real newline when it loads.
REPEAT_DECODE_REPLY=We already read him, Queen. Going back over it won't change what he showed you.\n\nWant to decode another man?

# The hard monthly ceiling. The service stops answering rather than letting the
# bill run. Spend is kept in SPEND_LEDGER_PATH so a restart does not forget it.
MONTHLY_SPEND_CEILING_USD=50.00
SPEND_LEDGER_PATH=server/.spend.json

# --- prices, per million tokens --------------------------------------------
# Defaults are the published Anthropic rates for claude-opus-5. Change these
# four numbers if the model or the price list changes; nothing else needs to.
PRICE_INPUT_PER_MTOK=5.00
PRICE_OUTPUT_PER_MTOK=25.00
PRICE_CACHE_WRITE_PER_MTOK=6.25
PRICE_CACHE_READ_PER_MTOK=0.50

# How long a cached prompt block survives. "5m" is the API default and measured
# cheapest at this traffic shape. "1h" survives longer but costs 2x to write
# instead of 1.25x — only worth it if conversations cluster within the hour.
CACHE_TTL=5m
# Blocks smaller than this are sent uncached; a breakpoint on a small block
# costs more to write than it ever saves.
MIN_CACHEABLE_CHARS=4000
